# ============================================================
# Makefile para Atlantica Cluster
# ============================================================
#
# Este Makefile adapta os comandos para o cluster Atlantica
# usando ladcomp e srun
#
# Uso na Atlantica:
#   make -f Makefile.atlantica all
#   make -f Makefile.atlantica run-experiments
#
# ============================================================

# Compiladores Atlantica
MPICC = ladcomp -env mpicc

# Flags de compilação
CFLAGS = -Wall -Wextra -O2

# Arquivos fonte MPI
MPI_MERGE_SRC = mpi_bubblesort.c
MPI_ODDEVEN_SRC = mpi_odd_even.c
MPI_QSORT_SRC = mpi_qsort.c

# Executáveis MPI
MPI_MERGE_BIN = mpi_merge
MPI_ODDEVEN_BIN = mpi_oddeven
MPI_QSORT_BIN = mpi_qsort

# Configurações de execução
NODES ?= 2
NP ?= 15
SIZE ?= 1000000
DELTA ?= 0

# ============================================================
# TARGETS DE COMPILAÇÃO
# ============================================================

.PHONY: all mpi mpi-merge mpi-oddeven mpi-qsort clean help

all: mpi

mpi: mpi-merge mpi-oddeven mpi-qsort

mpi-merge: $(MPI_MERGE_SRC)
	@echo "Compilando versão MPI com MERGE (interleaving)..."
	$(MPICC) $(CFLAGS) $(MPI_MERGE_SRC) -lm -o $(MPI_MERGE_BIN)
	@echo "✓ Compilação concluída: ./$(MPI_MERGE_BIN)"

mpi-oddeven: $(MPI_ODDEVEN_SRC)
	@echo "Compilando versão MPI com ODD-EVEN transposition..."
	$(MPICC) $(CFLAGS) $(MPI_ODDEVEN_SRC) -lm -o $(MPI_ODDEVEN_BIN)
	@echo "✓ Compilação concluída: ./$(MPI_ODDEVEN_BIN)"

mpi-qsort: $(MPI_QSORT_SRC)
	@echo "Compilando versão MPI com QUICKSORT paralelo..."
	$(MPICC) $(CFLAGS) $(MPI_QSORT_SRC) -lm -o $(MPI_QSORT_BIN)
	@echo "✓ Compilação concluída: ./$(MPI_QSORT_BIN)"

# ============================================================
# TARGETS DE EXECUÇÃO (usando srun)
# ============================================================

run-mpi-merge: mpi-merge
	@echo "\n========== EXECUTANDO MPI MERGE ($(NP) processos, $(NODES) nós) =========="
	srun --exclusive -N $(NODES) -n $(NP) ./$(MPI_MERGE_BIN) $(SIZE) $(DELTA) 0

run-mpi-oddeven: mpi-oddeven
	@echo "\n========== EXECUTANDO MPI ODD-EVEN ($(NP) processos, $(NODES) nós) =========="
	srun --exclusive -N $(NODES) -n $(NP) ./$(MPI_ODDEVEN_BIN) $(SIZE)

run-mpi-qsort: mpi-qsort
	@echo "\n========== EXECUTANDO MPI QUICKSORT ($(NP) processos, $(NODES) nós) =========="
	srun --exclusive -N $(NODES) -n $(NP) ./$(MPI_QSORT_BIN) $(SIZE) $(DELTA) 0

run-mpi: run-mpi-merge run-mpi-oddeven run-mpi-qsort

# Testes rápidos
test-mpi-small: mpi
	@echo "\n========== TESTE RÁPIDO (40 elementos, 7 processos, 1 nó) =========="
	srun --exclusive -N 1 -n 7 ./$(MPI_BIN) 40 10 1

test-mpi-1k: mpi
	@echo "\n========== TESTE 1K (1000 elementos, 7 processos, 1 nó) =========="
	srun --exclusive -N 1 -n 7 ./$(MPI_BIN) 1000 0 0

test-mpi-10k: mpi
	@echo "\n========== TESTE 10K (10000 elementos, 15 processos, 2 nós) =========="
	srun --exclusive -N 2 -n 15 ./$(MPI_BIN) 10000 0 0

# ============================================================
# BENCHMARKS NA ATLANTICA
# ============================================================

bench-atlantica: mpi seq
	@echo "\n========== BENCHMARK ATLANTICA - 1.000.000 elementos =========="
	@echo "\nSequencial:"
	@./$(SEQ_BIN) 1000000 0
	@echo "\nMPI - 3 processos (1 nó):"
	@srun --exclusive -N 1 -n 3 ./$(MPI_BIN) 1000000 0 0
	@echo "\nMPI - 7 processos (1 nó):"
	@srun --exclusive -N 1 -n 7 ./$(MPI_BIN) 1000000 0 0
	@echo "\nMPI - 15 processos (2 nós):"
	@srun --exclusive -N 2 -n 15 ./$(MPI_BIN) 1000000 0 0

# ============================================================
# EXPERIMENTOS COMPLETOS
# ============================================================

run-qsort-experiments: all
	@echo "\n========== EXPERIMENTOS: QUICKSORT VS ODD-EVEN =========="
	@echo "Este processo pode demorar alguns minutos..."
	./run_qsort_experiments.sh

run-experiments: run-qsort-experiments

# ============================================================
# UTILIDADES
# ============================================================

clean:
	@echo "Limpando arquivos compilados..."
	rm -f $(MPI_MERGE_BIN) $(MPI_ODDEVEN_BIN) $(MPI_QSORT_BIN)
	@echo "✓ Limpeza concluída"

clean-results:
	@echo "Limpando resultados de experimentos..."
	rm -rf results/*
	@echo "✓ Resultados limpos"

help:
	@echo "============================================================"
	@echo "Makefile - Atlantica Cluster (MPI apenas)"
	@echo "============================================================"
	@echo ""
	@echo "COMPILAÇÃO:"
	@echo "  make -f Makefile.atlantica all         - Compila todos os MPI"
	@echo "  make -f Makefile.atlantica mpi         - Compila todos os MPI"
	@echo "  make -f Makefile.atlantica mpi-qsort   - Compila apenas quicksort"
	@echo ""
	@echo "EXECUÇÃO:"
	@echo "  make -f Makefile.atlantica run-mpi     - Executa todos os MPI"
	@echo "  make -f Makefile.atlantica run-mpi-qsort - Executa quicksort"
	@echo ""
	@echo "TESTES:"
	@echo "  make -f Makefile.atlantica test-mpi-small  - Teste 40 elementos"
	@echo "  make -f Makefile.atlantica test-mpi-1k     - Teste 1K elementos"
	@echo "  make -f Makefile.atlantica test-mpi-10k    - Teste 10K elementos"
	@echo ""
	@echo "BENCHMARKS:"
	@echo "  make -f Makefile.atlantica bench-atlantica  - Benchmark completo"
	@echo ""
	@echo "EXPERIMENTOS:"
	@echo "  make -f Makefile.atlantica run-experiments  - Executa todos os experimentos"
	@echo ""
	@echo "PARÂMETROS CUSTOMIZADOS:"
	@echo "  make -f Makefile.atlantica run-mpi NODES=2 NP=15 SIZE=1000000"
	@echo ""
	@echo "LIMPEZA:"
	@echo "  make -f Makefile.atlantica clean         - Remove executáveis"
	@echo "  make -f Makefile.atlantica clean-results - Remove resultados"
	@echo ""
	@echo "============================================================"
